# FastBound MCP server configuration
# Copy to .env for local development (never commit .env).

# Required: your FastBound account number (the numeric id in your cloud.fastbound.com URL).
FASTBOUND_ACCOUNT_NUMBER=

# Required: API key generated in FastBound Settings > Account.
FASTBOUND_API_KEY=

# Recommended: default user email recorded as X-AuditUser on write operations (ATF audit trail).
# Must be a valid, active user on the account. Per-call `auditUser` overrides this.
FASTBOUND_AUDIT_USER=you@example.com

# Master write switch. When false (default) every write tool refuses and sends nothing.
FASTBOUND_ALLOW_WRITES=false

# Optional overrides.
# FASTBOUND_BASE_URL=https://cloud.fastbound.com
# FASTBOUND_API_VERSION=
