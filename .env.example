# FastBound MCP server configuration
# Copy to .env for local development (never commit .env).

# ---------------------------------------------------------------------------
# Multi-account layout (recommended): list the aliases, then configure each one.
# The first alias is active by default; FASTBOUND_DEFAULT_ACCOUNT overrides that.
# Any tool call can target another account for that call: account:"sandbox".
# ---------------------------------------------------------------------------
FASTBOUND_ACCOUNTS="main,sandbox"
FASTBOUND_DEFAULT_ACCOUNT="main"

# Per account, an alias "main" reads FASTBOUND_MAIN_* (dashes become underscores):
#   _ACCOUNT_NUMBER  required — the numeric id in your cloud.fastbound.com URL.
#   _API_KEY         required — API key from FastBound Settings > Account.
#                    Keys are account-bound: each account needs its own.
#   _AUDIT_USER      recommended — email recorded as X-AuditUser (ATF audit trail) on
#                    writes and on the bound-book / 4473 downloads, which refuse
#                    without one — so set it even on a read-only account. Must be an
#                    active user ON THAT account. Per-call `auditUser` overrides it.
#   _ALLOW_WRITES    per-account write switch. When false (default) every write tool
#                    refuses for that account and sends nothing.
#   _LABEL           optional human name shown in list_accounts and results.
#   _BASE_URL / _API_VERSION  optional overrides.
FASTBOUND_MAIN_LABEL="My Shop (PROD)"
FASTBOUND_MAIN_ACCOUNT_NUMBER=""
FASTBOUND_MAIN_API_KEY=""
FASTBOUND_MAIN_AUDIT_USER="you@example.com"
FASTBOUND_MAIN_ALLOW_WRITES="false"

FASTBOUND_SANDBOX_LABEL="Dev sandbox"
FASTBOUND_SANDBOX_ACCOUNT_NUMBER=""
FASTBOUND_SANDBOX_API_KEY=""
FASTBOUND_SANDBOX_AUDIT_USER="you@example.com"
FASTBOUND_SANDBOX_ALLOW_WRITES="true"

# Values shared by every account (each may still override them).
# FASTBOUND_AUDIT_USER=you@example.com
# FASTBOUND_ALLOW_WRITES=false
# FASTBOUND_BASE_URL=https://cloud.fastbound.com
# FASTBOUND_API_VERSION=

# ---------------------------------------------------------------------------
# Single-account layout (still supported): omit FASTBOUND_ACCOUNTS and set these.
# The account is exposed under the alias "default".
# ---------------------------------------------------------------------------
# FASTBOUND_ACCOUNT_NUMBER=
# FASTBOUND_API_KEY=
# FASTBOUND_AUDIT_USER=you@example.com
# FASTBOUND_ALLOW_WRITES=false
