{
  "name": "fastbound-mcp",
  "version": "0.2.0",
  "description": "MCP server for the FastBound firearms Acquisition & Disposition (A&D) API",
  "type": "module",
  "bin": {
    "fastbound-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fastbound",
    "ffl",
    "atf",
    "firearms"
  ],
  "license": "MIT",
  "author": "Anji Xu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuanji86/fastbound-mcp.git"
  },
  "homepage": "https://github.com/xuanji86/fastbound-mcp#readme",
  "bugs": {
    "url": "https://github.com/xuanji86/fastbound-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
